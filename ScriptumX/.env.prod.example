# Copy to .env.prod and fill in before starting production compose.
#   cp .env.prod.example .env.prod

DJANGO_SECRET_KEY=replace-with-a-long-random-string
# Optional mail (msmtp on host; see docker/msmtprc.example — no secrets in git)
# DJANGO_DEFAULT_FROM_EMAIL=scriptumx@example.com
# DJANGO_EMAIL_BACKEND=ScriptumX.mail.MsmtpEmailBackend
DJANGO_ALLOWED_HOSTS=scriptumx.example.com,localhost
# Required once TLS is terminated at a reverse proxy (Traefik/Caddy/nginx):
DJANGO_CSRF_TRUSTED_ORIGINS=https://scriptumx.example.com
DJANGO_BEHIND_PROXY=1
# Leave unset / 0 unless you intentionally bootstrap a non-default admin:
# DJANGO_ALLOW_BOOTSTRAP_SUPERUSER=0
